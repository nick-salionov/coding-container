#!/bin/bash
set -euo pipefail

# Root commands must not resolve executables from user-writable directories.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
user_path="/home/codex/.local/bin:$PATH"

export HOME=/home/codex
export CODEX_HOME="$HOME/.codex"

rm -rf "$CODEX_HOME/skills"
mkdir -p "$CODEX_HOME/skills"
cp -a /opt/codex-skills/. "$CODEX_HOME/skills/"

mkdir -p "$CODEX_HOME" "$HOME/.config/gh" /workspace
chown codex:codex /workspace
/usr/local/bin/seed-host-config

settings_file="$CODEX_HOME/app-server-daemon/settings.json"
if [[ ! -f "$settings_file" ]]; then
    gosu codex /usr/bin/env PATH="$user_path" codex app-server daemon bootstrap --remote-control
else
    gosu codex /usr/bin/env PATH="$user_path" codex app-server daemon enable-remote-control
    gosu codex /usr/bin/env PATH="$user_path" codex app-server daemon start
fi

exec gosu codex /usr/bin/env PATH="$user_path" "$@"
